# Copy to backend/.env and fill in. backend/.env is git-ignored. NEVER commit real keys.

# mock | anthropic | openai
#   mock = deterministic offline heuristic, NOT real AI (tests / offline demo only)
LLM_PROVIDER=mock

# Needed only for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Needed only for LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=60

# Optional. Default: SQLite file at backend/data/interview_coach.db
# DATABASE_URL=sqlite:///./data/interview_coach.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
